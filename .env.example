# ─────────────────────────────────────────────────────────────
# LiveKit migration — add these to your existing .env / .env.local
# (keep your existing DATABASE_URL, NEXT_PUBLIC_GEMINI_API_KEY,
#  Better Auth and Polar variables)
# ─────────────────────────────────────────────────────────────

# LiveKit Cloud (Settings -> Keys). Server SDK uses LIVEKIT_URL;
# the browser uses the public one. Both are the same wss:// URL.
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Shared secret between the Next app and the agent worker.
# Must match AGENT_API_SECRET in agent/.env. Use a long random string.
AGENT_API_SECRET=choose_a_long_random_shared_secret

# NOTE: Stream variables (NEXT_PUBLIC_STREAM_*, STREAM_*) are no longer used.
