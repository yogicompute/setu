# LiveKit Cloud (same project as the Next app)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Free STT (Groq-hosted Whisper)
GROQ_API_KEY=your_groq_api_key

# Free-tier LLM (Gemini) — the Google plugin reads GOOGLE_API_KEY
GOOGLE_API_KEY=your_gemini_api_key

# Free-tier TTS (Cartesia)
CARTESIA_API_KEY=your_cartesia_api_key

# How the worker reaches the Next app's internal API
APP_URL=http://localhost:3000
AGENT_API_SECRET=choose_a_long_random_shared_secret
